+            <Plus size={16} /> Log a reading
+          </button>
+        </div>
+      )}
+      {sorted.length > 0 && matchingReadings.length === 0 && (
+        <p className="muted">
+          No readings match your search.{" "}
+          <button onClick={() => onQueryChange("")}>Clear search</button>
+        </p>
+      )}
+    </section>
+  );
+}
